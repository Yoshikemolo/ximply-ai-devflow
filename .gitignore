# accumulate credentials, internal URLs, local paths and private prompts.
# Reviewed, reusable engineering instructions belong under /docs/ai instead.
.claude/*
!.claude/skills/
.cursor/
.settings/
.local-ai/
.ai-private/

# Secrets and local environment
.env
.env.*
!.env.example
*.local.json
